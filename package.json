{
  "name": "qelvion-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Qelvion-AI — Telegram AI platform on Cloudflare Workers + D1 + Queues",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply QELVION_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply QELVION_DB --remote",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "grammy": "latest"
  }
}
